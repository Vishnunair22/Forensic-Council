# Forensic Council - Caddy Reverse Proxy
#
# Development:
#   CADDY_SITE_ADDRESS=http://localhost
#
# Production:
#   DOMAIN=forensic.yourdomain.com
#   ACME_EMAIL=admin@yourdomain.com

{
    admin off
    email {$ACME_EMAIL:admin@localhost}
    http_port 80
    https_port 443
}

{$CADDY_SITE_ADDRESS:http://localhost} {

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-Robots-Tag "none"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Isolate browsing context — required for SharedArrayBuffer (used by audio/video WASM tools)
        # and hardens against Spectre-class side-channel attacks.
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"
        # Restrict browser feature access beyond what the app requires
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        # NOTE: Content-Security-Policy is intentionally NOT set here.
        # Next.js middleware (apps/web/src/middleware.ts) is the sole CSP authority.
        # It sets 'unsafe-inline' for scripts/styles (required by Next.js) and
        # derives the correct connect-src from NEXT_PUBLIC_API_URL.
        # A Caddy-level CSP would conflict and silently break the application in production.
        -Server
        -X-Powered-By
    }

    # Caddy-only LB check — used by Docker healthcheck
    handle /lb-health {
        header Cache-Control "no-store"
        respond "ok" 200
    }

    # Real backend health endpoint — exposed separately so external monitors can reach
    # the real FastAPI /health without being swallowed by the frontend catch-all.
    handle /health {
        reverse_proxy backend:8000 {
            header_up Host {host}
        }
    }

    # API: WebSocket Route (Long-lived connections, no compression, no timeout)
    handle /api/v1/sessions/*/live {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Upgrade {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
            flush_interval -1

            transport http {
                response_header_timeout 0
                dial_timeout 10s
            }
        }
    }

    # API: SSE Route (Long-lived streaming, no timeout, keepalive)
    handle /api/v1/sessions/*/progress {
        reverse_proxy backend:8000 {
            header_up Host {host}
            flush_interval -1

            transport http {
                response_header_timeout 0
                dial_timeout 10s
            }
        }
    }

    # API: REST Routes (Standard timeouts, 55MB limit, with compression)
    handle /api/v1/* {
        request_body {
            max_size 55MB
        }
        header Cache-Control "no-store"
        encode zstd gzip
        reverse_proxy backend:8000 {
            header_up Host {host}
            flush_interval -1

            transport http {
                response_header_timeout 620s
                dial_timeout 10s
                read_buffer 64KB
                write_buffer 64KB
            }
        }
    }

    # Next.js static assets.
    # IMPORTANT: filenames are only content-hashed in PRODUCTION (next build).
    # In dev mode (next dev), chunks are served at stable paths like
    # /_next/static/chunks/main-app.js with NO hash, so caching them as
    # immutable for a year freezes every HMR edit in the browser's disk cache.
    # The header is therefore parameterised; the dev-safe default is no-store,
    # and docker-compose.prod.yml overrides NEXT_STATIC_CACHE_CONTROL to enable
    # long-lived caching once filenames are actually hashed.
    handle /_next/static/* {
        header Cache-Control "{$NEXT_STATIC_CACHE_CONTROL:no-store, must-revalidate}"
        reverse_proxy frontend:3000 {
            header_up Host {host}
        }
    }

    # Frontend
    handle {
        encode zstd gzip
        reverse_proxy frontend:3000 {
            header_up Host {host}

            transport http {
                response_header_timeout 900s
                dial_timeout 10s
            }
        }
    }
}
