# Root Docker ignore — keeps build context lean

# Git
.git/
.gitignore
.gitattributes

# Docs (not needed in container)
*.md
docs/
README*
LICENSE

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
nul

# Environment (secrets)
.env
.env.*
!.env.example
.env.local

# Test/fixtures (run in CI, not inside container)
**/tests/
**/fixtures/
test_*

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
htmlcov/
.coverage
coverage.xml
coverage.json

# Frontend build artifacts
apps/web/node_modules/
apps/web/.next/
apps/web/coverage/
apps/web/playwright-report/
apps/web/test-results/

# Node caches
node_modules/
.npm/
.cache/
.turbo/

# Logs
*.log
logs/

# Scratch/temp
tmp/
temp/
scratch/

# Lock files
package-lock.json
pnpm-lock.yaml
yarn.lock