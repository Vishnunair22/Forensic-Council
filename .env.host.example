# ============================================================================
# WARNING: DO NOT use this file as the base `.env` for Docker Compose runs.
# This file is configured for HOST-RUN development (running uv / npm directly on your machine).
# Using this file in Docker will break Next.js server-side routing (INTERNAL_API_URL
# is set to localhost:8000 instead of backend:8000).
# For Docker Compose runs, copy `.env.example` to `.env` instead.
# ============================================================================

# ============================================================================
# Forensic Council — Environment Variables (Production-Hardened)
# ============================================================================
# SETUP:
#   1. cp .env.example .env       (bash/zsh)
#      Copy-Item .env.example .env (PowerShell)
#   2. Run ./infra/generate_production_keys.sh to populate secure secrets
#   3. Edit .env with your specific API keys (Groq/Gemini)
#   4. docker compose -f infra/docker-compose.yml --env-file .env up -d
#
# ⚠️  Never commit .env to source control.
# ⚠️  Production mode refuses to start if insecure defaults are detected.
# ⚠️  If you modify this file, you must run: `docker compose up -d --force-recreate` to apply changes.
# ============================================================================

# ─── Docker Project Name ─────────────────────────────────────────────────────
# ⚠️  COMPOSE_PROJECT_NAME in .env has NO EFFECT.
# The project name is hardcoded to 'forensic-council' via the `name:` directive
# in infra/docker-compose.yml to ensure all compose variants (dev, prod, override)
# always share the SAME named volume pool. Without this lock, Docker would prefix
# volumes differently by directory, causing full model re-downloads when switching
# between dev and prod modes.
# Do NOT set COMPOSE_PROJECT_NAME here — it will be silently ignored.
# COMPOSE_PROJECT_NAME=forensic-council

# ─── Application Global Settings ─────────────────────────────────────────────
# Set to 'production' only after running generate_production_keys.sh
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=forensic-council
OFFLINE_MODE=false

# ─── Core Security Keys ──────────────────────────────────────────────────────
# CRITICAL: Both keys must be unique, high-entropy, and at least 32 characters.
# Use ./infra/generate_production_keys.sh to generate these safely.

# Primary key for signing forensic audit logs (ECDSA provenance)
SIGNING_KEY=dev_signing_key_change_me_32_chars_minimum

# Secret key for JWT authentication session signing
JWT_SECRET_KEY=dev_jwt_secret_change_me_32_chars_minimum

# ─── Infrastructure (PostgreSQL) ─────────────────────────────────────────────
# Required — Settings constructs the connection URL from these components.
# ⚠️  NOTE: These values (postgres, redis, qdrant) are ignored in Docker mode
# because the docker-compose.yml hardcodes them. Adjust these ONLY if running
# in host-run (non-Docker) mode; for host-run, copy .env.host.example instead.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Development-only host port used by infra/docker-compose.dev.yml when running
# the API outside Docker while Postgres runs in Compose.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=forensic_user
POSTGRES_PASSWORD=dev_postgres_password_32chars_xx
POSTGRES_DB=forensic_council

# ── External-tooling only (DBeaver, pgcli, etc.) ─────────────────────────────
# pydantic-settings does NOT expand ${VAR} references in .env files.
# The application ignores this variable — it reads the component vars above.
# Substitute manually when connecting with an external SQL client.
# DATABASE_URL=postgresql+asyncpg://forensic_user:<POSTGRES_PASSWORD>@localhost:5432/forensic_council
# ─────────────────────────────────────────────────────────────────────────────

# ─── Infrastructure (Redis) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Development-only host port used by infra/docker-compose.dev.yml when running
# the API outside Docker while Redis runs in Compose.
REDIS_HOST_PORT=6379
# CRITICAL: Production mode REQUIRES a strong Redis password.
# All in-flight forensic state and task data traverses Redis.
REDIS_PASSWORD=dev_redis_password_32chars_xxxxx

# ─── Infrastructure (Qdrant) ─────────────────────────────────────────────
# Vector database for episodic memory and embedding storage.
# The backend reads QDRANT_HOST/PORT/GRPC_PORT/HTTPS — NOT QDRANT_URL.
# In Docker the compose file sets QDRANT_HOST=qdrant via x-backend-env.
# For host-run (no Docker) mode copy this file to .env.local and adjust values.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_HTTPS=false
# Host-side port for the dev overlay only
QDRANT_HOST_PORT=6333
# Host-side port for the dev overlay only
QDRANT_GRPC_HOST_PORT=6334
# CRITICAL: Production MUST set a strong API key — Qdrant exposes all
# vectors and collections to anyone who can reach port 6333 without one.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
QDRANT_API_KEY=dev_qdrant_key_32_chars_minimum_x

# ─── Authentication ──────────────────────────────────────────────────────────
# Passwords for the initial 'admin' and 'investigator' users.
# Only used on first run to bootstrap the database.
BOOTSTRAP_ADMIN_PASSWORD=dev_admin_password_32chars_xxxxx

# IMPORTANT: For local development 'Begin Analysis' (auto-login) to work,
# BOOTSTRAP_INVESTIGATOR_PASSWORD must match DEMO_PASSWORD below.
BOOTSTRAP_INVESTIGATOR_PASSWORD=dev_investigator_password_32_chars

# ─── Demo Auth ───────────────────────────────────────────────────────────────
# Server-side only password for the /api/auth/demo Next.js route.
# NOTE: For local dev "Begin Analysis" button to work (auto-login),
# this MUST match BOOTSTRAP_INVESTIGATOR_PASSWORD.
# Do NOT rename to NEXT_PUBLIC_DEMO_PASSWORD — that would bake it into the
# client JS bundle. Keep this server-side.
# Change this before any public deployment.
# IMPORTANT: For the demo login and "Begin Analysis" button to work,
# DEMO_PASSWORD must exactly match BOOTSTRAP_INVESTIGATOR_PASSWORD.
DEMO_PASSWORD=dev_investigator_password_32_chars

# NEXT_PUBLIC_API_URL: Keep empty for Docker/Production.
# When empty, the browser uses the same origin as the page (window.location.origin).
# This ensures traffic goes through Caddy (port 80) which handles CSRF and auth headers correctly.
# ⚠️  NOTE ON DOCKER DEV: The development overlay (infra/docker-compose.dev.yml)
# overrides this to 'http://localhost:8000' so that the browser talks directly to the backend
# bypassing Caddy (allowing easier API debugging). Do NOT set it to 'http://localhost:8000'
# here in .env; leave this empty unless running host-run mode without Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API URL for container-to-container communication (Next.js server-side)
INTERNAL_API_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Groq (Logic & Reasoning - Llama 3.3 70B)
# Get a key at: https://console.groq.com/keys
LLM_PROVIDER=none
LLM_API_KEY=__PASTE_GROQ_KEY_HERE__
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODELS=llama-3.1-8b-instant
LLM_ENABLE_REACT_REASONING=false
LLM_ENABLE_POST_SYNTHESIS=true

# Docker BUILD-TIME flag (consumed during `docker compose build`, not at runtime).
# Set to 1 to bake all ML models into the image (recommended for production).
# Set to 0 to skip — models download lazily on first analysis (slower first run).
PRELOAD_MODELS=1

# Local dev (no Docker): leave USE_REDIS_WORKER=false for in-process jobs.
USE_REDIS_WORKER=false

# Docker runtime: keep true so the API submits jobs to the worker service.
# Set to false only for a special single-container Docker debug session.
DOCKER_USE_REDIS_WORKER=false

# ─── Model Licensing (Commercial Use) ──────────────────────────────────────────
# IMPORTANT: Default models are Apache-2.0 or MIT licensed for commercial use.
#
# YOLO_MODEL_NAME default is "detr-resnet-50" (Apache-2.0, transformers).
# Set "yolo11n.pt" or "yolo11m.pt" ONLY if you have confirmed AGPL compliance
# (then also set ENABLE_AGPL_MODELS=true).
#
# ENABLE_AGPL_MODELS: enables Ultralytics YOLO. Default false (commercial-safe).
# ENABLE_RESEARCH_MODELS: enables BusterNet/F3-Net/ManTra-Net/TruFor/AASIST
#                        (research-only license). Default false.
ENABLE_AGPL_MODELS=false
ENABLE_RESEARCH_MODELS=false
YOLO_MODEL_NAME=detr-resnet-50
AASIST_MODEL_NAME=Vansh180/deepfake-audio-wav2vec2

# Google Gemini (Neural Vision & Audio Audit)
# Get a key at: https://aistudio.google.com/apikey
# REQUIRED for Agent 1, 3, 5 deep analysis passes.
GEMINI_API_KEY=__PASTE_GEMINI_KEY_HERE__
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CONCURRENT=2

# Separate Gemini key for the Council Arbiter (isolates Arbiter quota from agents).
# Leave empty to share the main GEMINI_API_KEY.
ARBITER_GEMINI_API_KEY=

# Gemini timeout in seconds for vision/audio requests (default: 55.0)
GEMINI_TIMEOUT=55.0

# Comma-separated ordered list of fallback Gemini models if the primary is
# unavailable or rate-limited.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite

# Acknowledge Gemini usage policy before enabling API calls.
# Read the terms at https://ai.google.dev/terms, then set to true.
# Leaving this false disables all Gemini calls (safe default for new deployments).
GEMINI_API_KEY_POLICY_OK=false

# ─── Per-provider Free-tier Quota Limits ─────────────────────────────────────
# Used by the quota guard before each call. Set to your actual tier limits.
# Conservative free-tier defaults are pre-filled.
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=1500
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=6000

# ─── TLS / HTTPS (Caddy) ─────────────────────────────────────────────────────
# Your public domain name. Caddy will automatically provision and renew
# Let's Encrypt TLS certificates when this is set to a real domain.
# Development: leave as "localhost" (self-signed, no ACME needed).
# Production:  set to your actual domain, e.g. forensic.yourdomain.com
DOMAIN=localhost

# Email for Let's Encrypt expiration notifications (required for production ACME).
# ⚠️  REQUIRED for production: Caddy provisions TLS automatically when DOMAIN is a real
# domain. Without a valid ACME_EMAIL, Let's Encrypt will use 'admin@localhost', which
# may cause rate limiting or prevent certificate renewal notifications from reaching you.
# Dev (DOMAIN=localhost) uses a self-signed cert — ACME_EMAIL is ignored in dev.
ACME_EMAIL=admin@yourdomain.com

# CADDY_SITE_ADDRESS: Explicit Caddy site address. In production, should be
# the full HTTPS URL: https://forensic.yourdomain.com
# Defaults to DOMAIN if not set. Dev uses http://localhost (no HTTPS needed).
# CADDY_SITE_ADDRESS=https://forensic.yourdomain.com

# ─── Operational Limits ──────────────────────────────────────────────────────
# Daily LLM/API cost budget in USD for regular users (hard stop when exceeded)
DAILY_COST_QUOTA_USD=50.0

# Daily LLM/API cost budget in USD for admin users (higher ceiling)
DAILY_COST_QUOTA_ADMIN_USD=500.0

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Q-C-2: RATE_LIMIT_AUTHENTICATED, RATE_LIMIT_ANONYMOUS, and
# RATE_LIMIT_INVESTIGATION_PER_5MIN were removed from this file in phase 14
# because they are not declared as Settings fields in core/config.py and have
# no consumer in the codebase — setting them previously had no effect. The
# actual rate-limit floor lives in apps/api/core/rate_limiting.py
# (MAX_INVESTIGATIONS_PER_USER / USER_RATE_WINDOW_SECS); promote those to
# Settings if you need per-deploy tuning.

# Timeout in seconds for the worker's periodic evidence cleanup task.
# Read directly by apps/api/orchestration/worker.py.
CLEANUP_TIMEOUT_SECONDS=3600

# Maximum number of worker processes for CPU-bound forensic analysis (ELA, FFT, etc.)
# Default: min(4, cpu_count)
FORENSIC_MAX_WORKERS=0

# ─── Performance & Caching ───────────────────────────────────────────────────
# Disable Numba JIT compilation inside containers (avoids LLVM overhead on
# CPU-only images; set to 0 only if you have a GPU and need JIT acceleration).
NUMBA_DISABLE_JIT=1

# Maximum seconds a single ML subprocess (torch model inference) is allowed to
# run before being forcibly killed. A subprocess that OOMs or deadlocks would
# otherwise block the agent thread indefinitely. Increase on slow hardware.
ML_SUBPROCESS_TIMEOUT_S=120

# ML Model Cache Paths (must match Docker volumes)
# These paths are used to store downloaded weights for YOLO, CLIP, EasyOCR, etc.
HF_HOME=.cache/huggingface
TORCH_HOME=.cache/torch
YOLO_MODEL_DIR=.cache/ultralytics
EASYOCR_MODEL_DIR=.cache/easyocr
NUMBA_CACHE_DIR=.cache/numba_cache

# ─── Observability ───────────────────────────────────────────────────────────
# OpenTelemetry configuration for Jaeger tracing
OTEL_ENABLED=true
OTEL_SERVICE_NAME=forensic-council-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Bearer token required by Prometheus to scrape /api/v1/metrics/raw.
# Must match the value in infra/prometheus.yml (bearer_token_file secret).
# Generate with: openssl rand -hex 32
# This token is NEVER returned to the frontend; it is used only by Prometheus.
METRICS_SCRAPE_TOKEN=dev_metrics_token_change_me_32_chars

# ─── Host-Run Mode (Local Development without Docker) ────────────────────────
# Use these overrides if running 'uv run scripts/run_api.py' directly on host.
# These map /app/ paths to local directories relative to project root.
# HF_HOME=./apps/api/.cache/huggingface
# TORCH_HOME=./apps/api/.cache/torch
# YOLO_MODEL_DIR=./apps/api/.cache/ultralytics
# EASYOCR_MODEL_DIR=./apps/api/.cache/easyocr
# NUMBA_CACHE_DIR=./apps/api/.cache/numba_cache

# ─── Production Hardening ────────────────────────────────────────────────────
# For production update DOMAIN (set above) to your real domain:
#   DOMAIN=forensic.yourdomain.com
# OFFLINE_MODE=true is already set above and is the correct production default.

# Max WebSocket connections per API process (default: 1000)
# Phase 14: now wired as a real Settings field in core/config.py.
MAX_WS_CONNECTIONS=1000

# When enabled, starting a new investigation automatically terminates any
# prior in-progress investigations from the same user. Defaults to false.
# SUPERSEDE_PRIOR_INVESTIGATIONS_ON_UPLOAD=false

# Q-C-2: SIGNING_FAILURE_QUEUE and ENFORCE_MODEL_SHA were removed from
# this file in phase 14 — neither is declared in core/config.py and
# neither has a consumer in the codebase. If signing dead-letter or
# model SHA enforcement features land in future, re-add them then.

# ─── Mismatched Keys Added for Parity with .env.example ──────────────────────
ANALYSIS_EXECUTION_MODE=local_only
LOG_FORMAT=console
VISION_PROVIDER_CHAIN=gemini,local_ensemble
TEXT_PROVIDER_CHAIN=groq,gemini,cerebras,template
GROQ_VISION_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_RPM_LIMIT=15
GROQ_VISION_RPD_LIMIT=14400
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_REFERER=https://forensic-council.local
OPENROUTER_VISION_MODELS=meta-llama/llama-3.2-11b-vision-instruct:free,qwen/qwen2.5-vl-7b-instruct:free,google/gemma-3-12b-it:free
OPENROUTER_RPM_LIMIT=20
OPENROUTER_RPD_LIMIT=200
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

